# GeoColombia API — variables de entorno (no commitear secretos).

# development | production | test
APP_ENV=development

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Orígenes CORS separados por coma.
# En development, si se deja vacío: http://localhost:5173 y http://127.0.0.1:5173
# En production: lista explícita (nunca "*"). Ejemplo futuro SWA:
# CORS_ALLOWED_ORIGINS=https://<app>.azurestaticapps.net
CORS_ALLOWED_ORIGINS=

# Swagger/ReDoc/OpenAPI. En production el default es false.
API_DOCS_ENABLED=true

# --- Capas IDEAM (opcionales; defaults en código) ---
# ALERT_LAYER_MAX_BBOX_SPAN_DEG=1.5
# ALERT_LAYER_MAX_FEATURES=250
# ALERT_LAYER_MAX_RESPONSE_BYTES=5000000
# ALERT_LAYER_REQUEST_TIMEOUT_SECONDS=25
# ALERT_LAYER_PAGE_SIZE=50
# ALERT_LAYER_CACHE_TTL_SECONDS=600
# ALERT_LAYER_CACHE_MAX_ENTRIES=64
# ALERT_LAYER_NATIONAL_MAX_ALLOWABLE_OFFSET=0.05
# ALERT_LAYER_NATIONAL_MAX_FEATURES=600
# ALERT_LAYER_NATIONAL_MAX_RESPONSE_BYTES=5000000
# ALERT_LAYER_NATIONAL_REQUEST_TIMEOUT_SECONDS=30
# ALERT_LAYER_NATIONAL_PAGE_SIZE=200
# ALERT_LAYER_NATIONAL_CACHE_TTL_SECONDS=700
